# Conexão com o PostgreSQL (container Docker)
# Local / mesmo host do container:
DATABASE_URL=postgresql://delivery:ALTERE_A_SENHA@localhost:5432/delivery
# Se o app também roda em container na mesma rede do compose, use o host "postgres":
# DATABASE_URL=postgresql://delivery:delivery@postgres:5432/delivery

# Credenciais usadas pelo docker-compose.yml ao criar o banco
POSTGRES_USER=delivery
POSTGRES_PASSWORD=
POSTGRES_DB=delivery
POSTGRES_PORT=5432

# Porta onde o app fica exposto no VPS
APP_PORT=3000

# Gere três segredos diferentes com: openssl rand -base64 48
# Use pelo menos 32 caracteres aleatórios; não reutilize os exemplos nem os comite.
ACCOUNT_SESSION_SECRET=
OPS_SESSION_SECRET=
SYSADM_SESSION_SECRET=

# Opcionais
# PGPOOL_MAX=5
# PGSSL_DISABLE=true
# Endpoint HTTP opcional para envio de email. Sem ele, o PIN é registrado no log do app.
# EMAIL_WEBHOOK_URL=https://seu-provedor.example/send
