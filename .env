# Conexão com o PostgreSQL (container Docker)
# Local / mesmo host do container:
DATABASE_URL=postgresql://delivery:delivery@localhost:5430/delivery
# Se o app também roda em container na mesma rede do compose, use o host "postgres":
# DATABASE_URL=postgresql://delivery:delivery@postgres:5430/delivery

# Credenciais usadas pelo docker-compose.yml ao criar o banco
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery
POSTGRES_DB=delivery
POSTGRES_PORT=5430

# Porta onde o app fica exposto no VPS
APP_PORT=3011

# Opcionais
# PGPOOL_MAX=5
# PGSSL_DISABLE=true
# Endpoint HTTP opcional para envio de email. Sem ele, o PIN é registrado no log do app.
# EMAIL_WEBHOOK_URL=https://seu-provedor.example/send
MAILERSEND_API_TOKEN=mlsn.b309a851e414fde797304b181bdba5f44f645559d21e37df52b06bd4e298ffb7
MAILERSEND_FROM_EMAIL=anderson.pmsg@gmail.com
MAILERSEND_FROM_NAME=VendeFácil
